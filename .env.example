# From your app at https://www.bungie.net/en/Application
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=
# Must match the Redirect URL set on the Bungie app exactly.
REDIRECT_URL=https://localhost:5443/auth/callback
PORT=5443
# The web app runs on PORT (HTTPS); the API server runs on API_PORT, localhost only.
API_PORT=5444
