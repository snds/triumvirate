# From your app at https://www.bungie.net/en/Application
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=
# Must match the Redirect URL set on the Bungie app exactly.
REDIRECT_URL=https://localhost:5443/auth/callback
PORT=5443
# The web app runs on PORT (HTTPS); the API server runs on API_PORT, localhost only.
API_PORT=5444
# For the agent side panel (Step 2). From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: local hour (0-23) to crawl public matches for community perk data while the server runs.
COMMUNITY_CRAWL_HOUR=
# Optional: local hour (0-23) to build the daily digest. It can also be built from the app at any time.
DIGEST_HOUR=
# Optional: minutes between watch list checks (vendors and new drops). Default 60; 0 turns it off.
WATCH_MINUTES=
