# Settings for the hosted copy. On Unraid this is the stack's .env file (deploy/README.md, step 5).
# Never commit the filled-in copy.

# From your SECOND Bungie app, the one whose Redirect URL is https://triumvirate.snds-server.com/auth/callback
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# From https://console.anthropic.com/settings/keys (leave blank to turn the chat off)
ANTHROPIC_API_KEY=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel)
TUNNEL_TOKEN=

# Cloudflare Access: your team domain and the app's Audience (AUD) tag (deploy/README.md, step 3)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Your own email, as a second lock behind the Access policy
ALLOWED_EMAILS=

# Your time zone, so the nightly crawl hour means your local time (e.g. America/Los_Angeles)
TZ=
# Optional: hour (0-23) to crawl public matches for community perk data each night
COMMUNITY_CRAWL_HOUR=
# Optional: hour (0-23) to build the daily digest (new drops, vendor picks, cleanup). Try 7, after the crawl.
DIGEST_HOUR=
# Optional: morning alert keys. Leave blank and the server makes a pair once and keeps it in /data/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: contact for push services (defaults to mailto: your first ALLOWED_EMAILS address)
VAPID_SUBJECT=
